theme = GitHub Dark
font-family = Monaspace Neon
font-size = 14

# ─── Window ───
window-padding-x = 8
window-padding-y = 4
window-decoration = true
macos-titlebar-style = tabs

# ─── Cursor ───
cursor-style = block
cursor-style-blink = false

# ─── Mouse ───
mouse-hide-while-typing = true
copy-on-select = clipboard

# ─── Shell integration ───
shell-integration = zsh
# ssh-env and ssh-terminfo make remote hosts understand TERM=xterm-ghostty. zsh/title.zsh and
# zsh/hooks.zsh set the window title, so no-title stops Ghostty from racing them.
shell-integration-features = cursor,sudo,no-title,ssh-env,ssh-terminfo

# ─── Notifications ───
# Let programs (Claude Code, Codex CLI) send desktop notifications via OSC 9 / OSC 777
desktop-notifications = true
# Notify when a command that ran longer than 10s finishes while Ghostty is unfocused
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 10s
# On bell: bounce the Dock icon, add 🔔 to the tab title, play the system sound
bell-features = attention,title,system

# ─── Clipboard ───
clipboard-read = ask
clipboard-write = allow
clipboard-paste-protection = true

# ─── Keyboard ───
# Left Option sends Alt, for Alt-C in fzf and Alt-B/Alt-F word movement. Right Option still
# types special characters.
macos-option-as-alt = left

# ─── Keybindings ───
# Only changes from the defaults (see `ghostty +list-keybinds --default`).
# Resize splits in bigger steps (default 10)
keybind = super+ctrl+arrow_left=resize_split:left,20
keybind = super+ctrl+arrow_right=resize_split:right,20
keybind = super+ctrl+arrow_up=resize_split:up,20
keybind = super+ctrl+arrow_down=resize_split:down,20

# Equalize splits (default super+ctrl+equal)
keybind = super+shift+equal=equalize_splits

# Open the visible screen's text in the default editor (default super+alt+shift+j)
keybind = super+shift+s=write_screen_file:open

# Show or hide the quick terminal from any app. Global keybinds need Ghostty in
# System Settings → Privacy & Security → Accessibility.
keybind = global:super+grave_accent=toggle_quick_terminal
