#!/bin/bash
set -euo pipefail

# git wt: manage a repo's worktrees under ~/.worktrees/<group>/<repo>/<name> ($WORKTREES_DIR),
# where <group>/<repo> is the main checkout's path under ~/Dev, else _/<basename>-<path hash>.
# The usage below is printed by usage(); only the path goes to stdout.
#
#   git wt path [<name>]       print the worktree path for <name>, or the repo's directory
#   git wt base                print the default base: origin's default branch, origin/main,
#                              origin/master, or HEAD
#   git wt add <name> [<base>] create or check out branch <name> in a worktree; print its path
#   git wt list                list the repo's worktrees
#   git wt rm [-f] [--delete-merged-branch] <name>
#                              remove the worktree; changes, untracked, or non-build ignored
#                              files need -f. --delete-merged-branch also deletes the branch
#                              when another branch has all its commits.
#   git wt prune [--session <id>]
#                              remove clean, merged worktrees and branches that Claude Code's
#                              worktree hook made, optionally only for one session

die() {
    echo "git wt: $*" >&2
    exit 1
}

usage() {
    sed -n 's/^#   //p' "$0" >&2
    exit 1
}

[ $# -gt 0 ] || usage

root="${WORKTREES_DIR:-$HOME/.worktrees}"
root="${root%/}"
# prune_empty climbs to $root, so a relative path or / would let it climb to /
case "$root" in
    /?*) ;;
    *) die "WORKTREES_DIR must be an absolute path other than /, not '${WORKTREES_DIR:-}'" ;;
esac

common="$(git rev-parse --path-format=absolute --git-common-dir 2> /dev/null)" ||
    die "not in a git repository"
# The common dir's parent is wrong for submodules (use core.worktree) and --separate-git-dir
# repos (fail from linked worktrees). Bare: repo/ for repo/.bare or .git, else foo for foo.git.
main_checkout() {
    local first dir
    if [ "$(git rev-parse --path-format=absolute --git-dir)" = "$common" ] &&
        git rev-parse --show-toplevel 2> /dev/null; then
        return
    fi
    # Without core.worktree, --git-dir would make the current directory the checkout
    if [ -n "$(git --git-dir="$common" config core.worktree 2> /dev/null)" ] &&
        git --git-dir="$common" rev-parse --show-toplevel 2> /dev/null; then
        return
    fi
    first="$(git worktree list --porcelain | sed -n '1,2p')"
    dir="${first%%$'\n'*}"
    dir="${dir#worktree }"
    case "$first" in
        *$'\nbare')
            case "${dir##*/}" in
                .bare | .git) dirname "$dir" ;;
                *) printf '%s\n' "${dir%.git}" ;;
            esac
            ;;
        *)
            [ "$dir" != "$(cd -P "$common" && pwd)" ] ||
                die "run git wt from the main checkout of a --separate-git-dir repo"
            printf '%s\n' "$dir"
            ;;
    esac
}
main="$(main_checkout)"
[ -n "$main" ] || die "couldn't find the main checkout"

# git prints resolved paths, so also compare against ~/Dev resolved
repo_key() {
    local dev rel
    for dev in "$HOME/Dev" "$(cd -P "$HOME/Dev" 2> /dev/null && pwd)"; do
        [ -n "$dev" ] || continue
        case "$main" in
            "$dev"/*/*)
                rel="${main#"$dev"/}"
                case "$rel" in
                    */*/*) ;;
                    *)
                        printf '%s\n' "$rel"
                        return
                        ;;
                esac
                ;;
        esac
    done
    printf '_/%s-%s\n' "${main##*/}" "$(printf '%s' "$main" | git hash-object --stdin | cut -c1-8)"
}

repo_dir="$root/$(repo_key)"

check_name() {
    [ -n "$1" ] || usage
    case "$1" in
        -*) die "'$1' isn't a valid branch name" ;;
    esac
    git check-ref-format "refs/heads/$1" || die "'$1' isn't a valid branch name"
}

# Not --short, which prints heads/<name> when a tag shares the name
worktree_branch() {
    local ref
    ref="$(git -C "$1" symbolic-ref --quiet HEAD 2> /dev/null || true)"
    printf '%s\n' "${ref#refs/heads/}"
}

is_repo_worktree() {
    [ -d "$1" ] &&
        [ "$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2> /dev/null)" = "$common" ] &&
        [ "$(cd -P "$1" && pwd)" = "$(git -C "$1" rev-parse --show-toplevel)" ]
}

prune_empty() {
    local dir="$1"
    while [ "$dir" != "$root" ] && [ "${dir#"$root"/}" != "$dir" ] &&
        { [ ! -e "$dir" ] || rmdir "$dir" 2> /dev/null; }; do
        dir="$(dirname "$dir")"
    done
}

cmd_path() {
    if [ $# -eq 0 ]; then
        printf '%s\n' "$repo_dir"
        return
    fi
    check_name "$1"
    printf '%s\n' "$repo_dir/$1"
}

# Full refs, so a tag named origin/main can't stand in
cmd_base() {
    local ref
    for ref in "$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2> /dev/null || true)" \
        refs/remotes/origin/main refs/remotes/origin/master; do
        if [ -n "$ref" ] && git show-ref --verify --quiet "$ref"; then
            printf '%s\n' "$ref"
            return
        fi
    done
    echo HEAD
}

cmd_add() {
    local name="${1:-}" base="${2:-}" path
    check_name "$name"
    # git reads options after positionals, so --lock or --force here would reach it as one
    case "$base" in
        -*) die "'$base' isn't a valid base" ;;
    esac
    path="$repo_dir/$name"
    if is_repo_worktree "$path"; then
        [ "$(worktree_branch "$path")" = "$name" ] ||
            die "$path is a worktree, but doesn't have $name checked out"
        echo "git wt: $path already exists" >&2
        printf '%s\n' "$path"
        return
    fi
    # Drop a stale registration for this path only (not git worktree prune). Parents first so git
    # can resolve the path.
    mkdir -p "$(dirname "$path")"
    [ -e "$path" ] || git worktree remove "$path" 2> /dev/null || true
    local add=()
    if git show-ref --verify --quiet "refs/heads/$name"; then
        [ -z "$base" ] || echo "git wt: branch $name exists, so $base is ignored" >&2
        add=("$path" "$name")
    elif [ -z "$base" ] && git show-ref --verify --quiet "refs/remotes/origin/$name"; then
        add=(--track -b "$name" "$path" "refs/remotes/origin/$name")
    else
        [ -n "$base" ] || base="$(cmd_base)"
        # Otherwise a branch made from origin/main would push to main
        add=(--no-track -b "$name" "$path" "$base")
    fi
    if ! git worktree add "${add[@]}" >&2; then
        prune_empty "$path"
        exit 1
    fi
    printf '%s\n' "$path"
}

cmd_list() {
    local dir line
    dir="$(cd -P "$repo_dir" 2> /dev/null && pwd)" || return 0
    git worktree list | while IFS= read -r line; do
        case "$line" in
            "$dir"/*) printf '%s\n' "$line" ;;
        esac
    done
}

# ignored_files <worktree> kept|rebuildable. -z: git otherwise quotes unusual names.
ignored_files() {
    local entry path kind
    git -C "$1" status --porcelain -z --ignored --untracked-files=normal 2> /dev/null |
        while IFS= read -r -d '' entry; do
            case "$entry" in
                '!! '*) path="${entry#'!! '}" ;;
                *) continue ;;
            esac
            case "${path%/}" in
                node_modules | */node_modules | .venv | */.venv | venv | target | */target | dist | */dist | \
                    build | */build | .next | */.next | .turbo | */.turbo | __pycache__ | */__pycache__ | \
                    .pytest_cache | */.pytest_cache | .mypy_cache | */.mypy_cache | .ruff_cache | */.ruff_cache | \
                    .cache | */.cache | coverage | */coverage | .gradle | */.gradle | .svelte-kit | */.svelte-kit | \
                    .tox | */.tox | *.egg-info | .DS_Store | */.DS_Store) kind=rebuildable ;;
                *) kind=kept ;;
            esac
            [ "$kind" != "$2" ] || printf '%s\n' "$path"
        done
}

print_group() {
    [ -n "$2" ] || return 0
    echo "  $1:"
    printf '%s\n' "$2" | sed 's/^/    /'
}

cmd_rm() {
    local force=() delete_branch=false name="" arg path branch changes tracked untracked ignored rebuildable
    for arg in "$@"; do
        case "$arg" in
            -f | --force) force=(--force) ;;
            --delete-merged-branch) delete_branch=true ;;
            *)
                [ -z "$name" ] || usage
                name="$arg"
                ;;
        esac
    done
    check_name "$name"
    path="$repo_dir/$name"
    # git worktree remove deletes ignored files silently and doesn't name what --force deletes
    if [ ${#force[@]} -eq 0 ] && [ -d "$path" ]; then
        changes="$(git -C "$path" status --porcelain --untracked-files=normal 2> /dev/null)" || changes=""
        tracked="$(printf '%s\n' "$changes" | sed -n '/^??/d; s/^...//p')"
        untracked="$(printf '%s\n' "$changes" | sed -n 's/^?? //p')"
        ignored="$(ignored_files "$path" kept)" || ignored=""
        if [ -n "$tracked$untracked$ignored" ]; then
            {
                echo "git wt: removing $path would delete:"
                print_group "modified or staged files" "$tracked"
                print_group "untracked files" "$untracked"
                print_group "ignored files" "$ignored"
            } >&2
            die "keep what you need, then run git wt rm -f $name, which deletes all of these"
        fi
        # Named, since build/ etc. can hold hand-written files
        rebuildable="$(ignored_files "$path" rebuildable)" || rebuildable=""
        if [ -n "$rebuildable" ]; then
            echo "git wt: also deleting ignored build output, caches, and dependencies:" >&2
            printf '%s\n' "$rebuildable" | sed 's/^/    /' >&2
        fi
    fi
    branch="$(worktree_branch "$path")"
    git worktree remove ${force[@]+"${force[@]}"} "$path"
    prune_empty "$(dirname "$path")"
    # Not branch -d, which keeps a branch made from an origin/main newer than HEAD
    if "$delete_branch" && [ -n "$branch" ]; then
        if is_merged "$branch"; then
            git branch -D "$branch" >&2
        else
            echo "git wt: kept branch $branch, which has commits no other branch has" >&2
        fi
    fi
}

# Written to the worktree's git dir by ai_tools/claude-code/worktree-hook.sh
CREATED_BRANCH_MARKER=worktree-hook-created-branch
SESSION_MARKER=worktree-hook-session

# Kept ignored files are clean only when identical to the main checkout's (.worktreeinclude)
is_clean() {
    local changes files file
    changes="$(git -C "$1" status --porcelain --untracked-files=normal)" || return 1
    [ -z "$changes" ] || return 1
    # exit, not return: the loop runs in a subshell, and pipefail fails the pipeline with it
    files="$(ignored_files "$1" kept | while IFS= read -r file; do find "$1/${file%/}" ! -type d || exit 1; done)" ||
        return 1
    while IFS= read -r file; do
        [ -z "$file" ] || same_file "$file" "$main/${file#"$1"/}" || return 1
    done <<< "$files"
}

# cmp follows symlinks, so a link matches only a link to the same target. A file may match a
# link, since the hook copies link targets.
same_file() {
    if [ -L "$1" ]; then
        [ -L "$2" ] && [ "$(readlink "$1")" = "$(readlink "$2")" ]
    else
        cmp -s "$1" "$2"
    fi
}

# Read whole first: grep -q exiting early would SIGPIPE a long listing
is_merged() {
    local refs
    refs="$(git for-each-ref --contains "refs/heads/$1" --format='%(refname)' refs/heads refs/remotes)" ||
        return 1
    [ -n "$refs" ] && grep -qvxF "refs/heads/$1" <<< "$refs"
}

cmd_prune() {
    local session="" dir here list path name gitdir status=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --session)
                [ -n "${2:-}" ] || usage
                session="$2"
                shift 2
                ;;
            *) usage ;;
        esac
    done
    dir="$(cd -P "$repo_dir" 2> /dev/null && pwd)" || return 0
    # git can't remove the worktree it runs from
    here="$(pwd -P)"
    list="$(git worktree list --porcelain | sed -n 's/^worktree //p')"
    while IFS= read -r path; do
        case "$path" in "$dir"/*) ;; *) continue ;; esac
        case "$here/" in "$path"/*) continue ;; esac
        name="${path#"$dir"/}"
        gitdir="$(git -C "$path" rev-parse --absolute-git-dir 2> /dev/null)" || continue
        [ -f "$gitdir/$CREATED_BRANCH_MARKER" ] || continue
        if [ -n "$session" ] && [ "$(cat "$gitdir/$SESSION_MARKER" 2> /dev/null)" != "$session" ]; then
            continue
        fi
        # The hook names the branch after the worktree
        if [ "$(worktree_branch "$path")" != "$name" ] || ! is_clean "$path" || ! is_merged "$name"; then
            continue
        fi
        if git worktree remove "$path" && git branch -D "$name" > /dev/null; then
            echo "git wt: removed $path and branch $name" >&2
        else
            status=1
        fi
        # Not $path: git resolves it, and $root may not be resolved
        prune_empty "$(dirname "$repo_dir/$name")"
    done <<< "$list"
    return "$status"
}

command="$1"
shift
case "$command" in
    path) cmd_path "$@" ;;
    base)
        [ $# -eq 0 ] || usage
        cmd_base
        ;;
    add) cmd_add "$@" ;;
    list) cmd_list ;;
    rm | remove) cmd_rm "$@" ;;
    prune) cmd_prune "$@" ;;
    *) usage ;;
esac
