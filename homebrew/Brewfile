# Formulae and App Store apps for the homebrew step. Casks stay in homebrew/install.sh, which
# skips apps installed outside Homebrew, where brew bundle would fail. So brew bundle cleanup with
# this file would uninstall every cask: don't run it.

# Core
brew "git"
brew "vim"
brew "starship"

# Terminal multiplexer
brew "tmux"

# Search and navigation
brew "fzf"
brew "ripgrep"
brew "fd"
brew "broot"
brew "zoxide"

# Git tools
brew "gh"
brew "git-delta"
brew "lazygit"
brew "difftastic"
brew "git-absorb"

# File viewing
brew "bat"
brew "bat-extras"
brew "glow"

# Disk and process tools
brew "dust"
brew "duf"
brew "procs"

# Modern replacements
brew "eza"
brew "sd"
brew "doggo"

# Data processing
brew "jq"
brew "yq"

# Networking
brew "httpie"

# Development utilities
brew "shellcheck"
brew "tokei"
brew "hyperfine"
brew "watchexec"
brew "grex"
brew "just"
brew "atuin"
brew "tlrc"
brew "lazydocker"

# Encryption
brew "age"

# Version management and package managers
brew "mise"
brew "uv"
brew "pnpm"
brew "bun"

# Zsh plugins
brew "zsh-syntax-highlighting"
brew "zsh-autosuggestions"

# Formulae with no Linux build. zsh isn't here: the login shell is the system's, macOS's /bin/zsh
# or apt's on Ubuntu, so it stays usable if Homebrew breaks.
if OS.mac?
  brew "terminal-notifier"
  # The PAM module Touch ID for sudo needs inside tmux (macos/setup-touch-id-sudo.sh)
  brew "pam-reattach"
  # Mac App Store CLI
  brew "mas"

  # Apple Silicon sensors: power, temperatures, and memory
  brew "macmon"

  # brew bundle runs mas install, then mas get, which takes a free app the Apple Account doesn't
  # have yet. So once you're signed in to the App Store, the free apps install by themselves, while
  # a paid app such as Dato needs buying there once.
  mas "Amphetamine", id: 937984704
  mas "Dato", id: 1470584107
  mas "Windows App", id: 1295203466
end
