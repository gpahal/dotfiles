#!/bin/bash
set -uo pipefail

# Switches the monitor to this machine while it has the trigger device, and to the other machine
# once it's gone, as /etc/dotfiles/monitor-input.conf says. Run as root by
# dotfiles-monitor-input.service, which the udev rule restarts on each of the device's events, so
# a run still settling is dropped for the newer one. The Mac only switches the monitor to itself,
# so when the devices leave both machines this one alone switches it, to the Mac. The monitor
# sometimes misses a command, so each run reads the input back and retries until it switches.
# Once it shows the other machine, the monitor can stop answering reads (writes still work), so
# an unreadable input after switching away counts as switched.

CONF="${MONITOR_INPUT_CONF:-/etc/dotfiles/monitor-input.conf}"
USB_DEVICES_DIR="${USB_DEVICES_DIR:-/sys/bus/usb/devices}"
DRM_DIR="${DRM_DIR:-/sys/class/drm}"
# The switch moves its devices one by one; this outlasts that
SETTLE="${MONITOR_INPUT_SETTLE:-1}"
# How long the monitor takes to switch before it reports the new input
VERIFY_DELAY="${MONITOR_INPUT_VERIFY_DELAY:-2}"
TRIES=5

conf_get() {
    sed -n "s/^$1=//p" "$CONF" | tail -n 1
}

device_present() {
    local dir
    for dir in "$USB_DEVICES_DIR"/*; do
        [ "$(cat "$dir/idVendor" 2>/dev/null):$(cat "$dir/idProduct" 2>/dev/null)" != "$1" ] || return 0
    done
    return 1
}

# The I2C bus number of the connector's DDC channel, which can change across boots
ddc_bus() {
    local link
    for link in "$DRM_DIR"/card*-"$1"/ddc; do
        [ -e "$link" ] || continue
        link="$(readlink -f "$link")" || continue
        link="${link##*/}"
        [[ "$link" =~ ^i2c-[0-9]+$ ]] || continue
        echo "${link#i2c-}"
        return 0
    done
    return 1
}

# The input the monitor shows, in decimal
current_input() {
    local out
    out="$(ddcutil --bus "$1" getvcp 60 --brief 2>/dev/null)" || return 1
    # VCP 60 SNC x1b
    [[ "$out" =~ \ x([0-9a-fA-F]+)$ ]] || return 1
    echo $((16#${BASH_REMATCH[1]}))
}

main() {
    local device input other connector bus target try now=""
    [ -r "$CONF" ] || exit 0
    device="$(conf_get device)"
    input="$(conf_get input)"
    other="$(conf_get other)"
    connector="$(conf_get connector)"
    if ! [[ "$device" =~ ^[0-9a-f]{4}:[0-9a-f]{4}$ && "$input" =~ ^[0-9]+$ && "$other" =~ ^[0-9]+$ && -n "$connector" ]]; then
        echo "$CONF needs device, input, other, and connector; re-run just monitor-input." >&2
        exit 1
    fi
    sleep "$SETTLE"
    if device_present "$device"; then
        target="$input"
    else
        target="$other"
    fi
    if ! bus="$(ddc_bus "$connector")"; then
        echo "No DDC bus for the $connector connector; check the monitor's cable, then re-run just monitor-input." >&2
        exit 1
    fi
    echo "Switching the monitor's input to $target (the trigger device is $([ "$target" == "$input" ] && echo here || echo away))."
    for ((try = 1; try <= TRIES; try++)); do
        [ "$try" -eq 1 ] || echo "The monitor shows input ${now:-(unreadable)}; trying again ($try of $TRIES)."
        # --noverify: ddcutil reads back at once, before the monitor has switched
        if ddcutil --bus "$bus" --noverify setvcp 60 "$target"; then
            sleep "$VERIFY_DELAY"
            if now="$(current_input "$bus")"; then
                [ "$now" != "$target" ] || return 0
            elif [ "$target" != "$input" ]; then
                echo "The monitor no longer answers, as when it shows the other machine; taking it as switched."
                return 0
            else
                now=""
            fi
        else
            now=""
            sleep "$VERIFY_DELAY"
        fi
    done
    echo "The monitor didn't switch to input $target after $TRIES tries." >&2
    exit 1
}

main "$@"
