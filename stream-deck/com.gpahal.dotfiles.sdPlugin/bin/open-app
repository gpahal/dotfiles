#!/bin/bash
set -uo pipefail

# Usage: open-app claude|chrome|chrome-tab|gmail|t3-code|activity-monitor
# Open Claude, Google Chrome, T3 Code, or Activity Monitor, or bring it to the front when it's
# running. chrome-tab then opens a new Chrome tab, and when the clipboard holds text, pastes it
# into the address bar and selects it. hammerspoon/init.lua does the same for its hotkeys. gmail
# brings Chrome's first Gmail tab to the front, or opens Gmail in a new tab when none is open. The
# Stream Deck plugin runs it for each key press, so macOS asks Stream Deck for its permissions:
# Automation for System Events and Google Chrome, and Accessibility to send the new tab's
# keystrokes.
#
# Each run prints a line to stderr, which the plugin passes to Stream Deck's log. It exits 1, and
# shows a notification saying why, when it couldn't open the app or send the keystrokes.

# Stream Deck starts plugins with a minimal environment
PATH="${PATH:+$PATH:}/usr/bin:/bin"
CLAUDE=com.anthropic.claudefordesktop
CHROME=com.google.Chrome
T3_CODE=com.t3tools.t3code
ACTIVITY_MONITOR=com.apple.ActivityMonitor
GMAIL_URL=https://mail.google.com/mail/u/0/#inbox

# Stream Deck adds the time to each line it logs
log() {
    printf '%s\n' "$*" >&2
}

notify() {
    osascript - "$1" <<'EOF' > /dev/null 2>&1
on run argv
    display notification (item 1 of argv) with title "Stream Deck"
end run
EOF
}

# Whitespace alone isn't worth pasting
clipboard_has_text() {
    pbpaste 2> /dev/null | grep -q '[^[:space:]]'
}

# Wait for Chrome to come to the front, which includes starting it, then press Cmd+T, and with
# "paste", Cmd+V and Cmd+A once the new tab's address bar has focus. With no window open, Cmd+T
# opens one. Prints why it failed: -1743 is a denied Automation prompt, and 1002 or -25211 is
# missing Accessibility.
new_tab() {
    osascript - "$1" <<EOF 2>&1 > /dev/null
on run argv
    tell application "System Events"
        repeat 100 times
            if bundle identifier of (first application process whose frontmost is true) is "$CHROME" then exit repeat
            delay 0.1
        end repeat
        if bundle identifier of (first application process whose frontmost is true) is not "$CHROME" then
            error "Google Chrome didn't come to the front"
        end if
        keystroke "t" using command down
        if item 1 of argv is "paste" then
            delay 0.15
            keystroke "v" using command down
            keystroke "a" using command down
        end if
    end tell
end run
EOF
}

# Select the first tab, front window first, whose URL is Gmail's, and raise its window, or open
# Gmail in a new tab of the front window. Chrome's own AppleScript does this, so it needs no
# Accessibility. Prints "found" or "opened", or why it failed: -1743 is a denied Automation prompt.
gmail_tab() {
    osascript - "$GMAIL_URL" <<EOF 2>&1
on run argv
    tell application id "$CHROME"
        repeat with w in windows
            set urls to URL of tabs of w
            repeat with i from 1 to count of urls
                if item i of urls starts with "https://mail.google.com/" then
                    set active tab index of w to i
                    if minimized of w then set minimized of w to false
                    set index of w to 1
                    activate
                    return "found"
                end if
            end repeat
        end repeat
        if (count of windows) is 0 then make new window
        tell window 1 to make new tab with properties {URL:item 1 of argv}
        activate
        return "opened"
    end tell
end run
EOF
}

main() {
    local target="${1:-}" bundle name paste=no err out
    case "$target" in
        claude) bundle="$CLAUDE" name=Claude ;;
        chrome | chrome-tab | gmail) bundle="$CHROME" name="Google Chrome" ;;
        t3-code) bundle="$T3_CODE" name="T3 Code" ;;
        activity-monitor) bundle="$ACTIVITY_MONITOR" name="Activity Monitor" ;;
        *)
            echo "Usage: open-app claude|chrome|chrome-tab|gmail|t3-code|activity-monitor" >&2
            return 2
            ;;
    esac
    if ! open -b "$bundle"; then
        log "ERROR couldn't open $name"
        notify "Couldn't open $name. Is it installed?"
        return 1
    fi
    if [ "$target" == gmail ]; then
        if ! out="$(gmail_tab)"; then
            err="$(printf '%s' "$out" | tr '\n' ' ')"
            err="${err% }"
            log "ERROR $err"
            if printf '%s' "$err" | grep -q -- '-1743'; then
                notify "Stream Deck lacks a permission: $err"
            else
                notify "Couldn't open Gmail. See ~/Library/Logs/ElgatoStreamDeck/com.gpahal.dotfiles0.log"
            fi
            return 1
        fi
        if [ "$out" == found ]; then
            log "$target: brought the Gmail tab to the front"
        else
            log "$target: opened Gmail in a new tab"
        fi
        return 0
    fi
    if [ "$target" != chrome-tab ]; then
        log "$target: opened $name"
        return 0
    fi
    ! clipboard_has_text || paste="paste"
    if ! err="$(new_tab "$paste")"; then
        err="$(printf '%s' "$err" | tr '\n' ' ')"
        err="${err% }"
        log "ERROR $err"
        if printf '%s' "$err" | grep -qE -- '-1743|-25211|\(1002\)|assistive access'; then
            notify "Stream Deck lacks a permission: $err"
        else
            notify "Couldn't open a new Chrome tab. See ~/Library/Logs/ElgatoStreamDeck/com.gpahal.dotfiles0.log"
        fi
        return 1
    fi
    if [ "$paste" == paste ]; then
        log "$target: opened a new tab with the clipboard pasted"
    else
        log "$target: opened a new tab"
    fi
}

main "$@"
