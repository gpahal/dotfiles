#!/bin/bash
set -uo pipefail

# Usage: open-in files|editor|terminal|claude|chrome|chrome-tab|gmail|t3-code|activity-monitor
# files, editor, and terminal open what's in front in Finder, Zed, or Ghostty: a Ghostty tab's
# folder, the file open in Zed, Finder's selection (or its front window's folder), or the folder of
# the thread T3 Code shows. With no path to use, such as with another app in front, they open a new
# window instead: Finder and Ghostty at home, Zed empty.
# The others open Claude, Google Chrome, T3 Code, or Activity Monitor, or bring it to the front
# when it's running. chrome-tab then opens a new Chrome tab, and when the clipboard holds text,
# pastes it into the address bar and selects it. gmail brings Chrome's first Gmail tab to the
# front, or opens Gmail in a new tab when none is open.
# The Stream Deck plugin runs it for each key press, and Hammerspoon's Ctrl+Opt+Cmd+T, E, and N
# run a copy, so macOS asks each for its permissions: Automation for Ghostty, Finder, System
# Events, and Google Chrome, and Accessibility to read Zed's window title and T3 Code's page, and
# to send the new tab's keystrokes. OPEN_IN_CALLER and OPEN_IN_LOG name the app running it and
# where its log goes, for the notifications.
#
# Each run prints a line to stderr, which the caller adds to its log. It exits 1 when it couldn't
# open anything, or when a missing permission kept it from reading the path, though it still opens
# a new window then. Either way it shows a notification saying why, and the plugin shows a warning
# on the key.

# Stream Deck starts plugins with a minimal environment
PATH="${PATH:+$PATH:}/usr/bin:/bin"
GHOSTTY=com.mitchellh.ghostty
ZED=dev.zed.Zed
ZED_CLI="${DOTFILES_ZED_CLI:-/Applications/Zed.app/Contents/MacOS/cli}"
T3_CODE=com.t3tools.t3code
CLAUDE=com.anthropic.claudefordesktop
CHROME=com.google.Chrome
ACTIVITY_MONITOR=com.apple.ActivityMonitor
GMAIL_URL=https://mail.google.com/mail/u/0/#inbox
T3_STATE="${DOTFILES_T3_STATE:-$HOME/.t3/userdata/statev2.sqlite}"
CALLER="${OPEN_IN_CALLER:-Stream Deck}"
CALLER_LOG="${OPEN_IN_LOG:-~/Library/Logs/ElgatoStreamDeck/com.gpahal.dotfiles0.log}"
# The functions set these rather than print them, since a command substitution's subshell would
# lose PERMISSION_ERROR
SCRIPT_RESULT=""
PERMISSION_ERROR=""
CONTEXT_PATH=""
# The notification for a failure that isn't a missing permission
FAILURE=""

# Stream Deck and Hammerspoon add the time to each line they log
log() {
    printf '%s\n' "$*" >&2
}

notify() {
    osascript - "$1" "$CALLER" <<'EOF' > /dev/null 2>&1
on run argv
    display notification (item 1 of argv) with title (item 2 of argv)
end run
EOF
}

# Run AppleScript from stdin with the arguments as argv, setting SCRIPT_RESULT to its result. With
# -l JavaScript first, run JavaScript for Automation instead. A failure is logged, and one for a
# missing permission sets PERMISSION_ERROR: -1743 is a denied Automation prompt, and -25211, 1002,
# or "assistive access" is missing Accessibility. Missing Accessibility can also come as -1719, but
# so does Zed with no window open, so the code alone isn't enough.
applescript() {
    local err status=0 lang=()
    if [ "${1:-}" == -l ]; then
        lang=(-l "$2")
        shift 2
    fi
    SCRIPT_RESULT=""
    err="$(mktemp)" || return 1
    SCRIPT_RESULT="$(osascript ${lang[@]+"${lang[@]}"} - "$@" 2> "$err")" || status=$?
    if [ "$status" -ne 0 ]; then
        log "ERROR $(tr '\n' ' ' < "$err")"
        if grep -qE -- '-1743|-25211|\(1002\)|assistive access' "$err"; then
            PERMISSION_ERROR="$(head -n 1 "$err")"
        fi
    fi
    rm -f "$err"
    return "$status"
}

# Print the bundle ID of an app given lsappinfo's ID for it
bundle_id() {
    lsappinfo info -only bundleID "$1" 2> /dev/null | sed -n 's/.*bundleID="\([^"]*\)".*/\1/p'
}

app_running() {
    [ -n "$(lsappinfo find "bundleid=$1" 2> /dev/null)" ]
}

ghostty_folder() {
    applescript <<EOF || return 1
tell application id "$GHOSTTY" to get working directory of focused terminal of selected tab of front window
EOF
    CONTEXT_PATH="$SCRIPT_RESULT"
    # Ghostty learns the folder from its shell integration's OSC 7 report, which it drops when
    # the hostname doesn't fit in a URL. The macos step sets one that does.
    [ -n "$CONTEXT_PATH" ] ||
        log "Ghostty doesn't know the tab's folder. Run: bash setup.sh --status macos"
}

# zed/settings.json sets window_title_format to "${projectName}${separator}${filePath}", and the
# separator is Zed's default " — ". A project name has no slash, so the path starts after the
# first separator followed by / or ~/. With no file open, the title is only the project name.
zed_file() {
    local title
    applescript <<EOF || return 1
tell application "System Events" to get name of window 1 of (first process whose bundle identifier is "$ZED")
EOF
    title="$SCRIPT_RESULT"
    case "$title" in
        *" — /"*) CONTEXT_PATH="/${title#*" — /"}" ;;
        *" — ~/"*) CONTEXT_PATH="$HOME/${title#*" — ~/"}" ;;
    esac
}

# T3 Code's page URL ends with the thread it shows, as t3code://app/#/<environment>/<thread>.
# AppleScript can't read the web view's AXURL, so JavaScript for Automation calls the
# Accessibility API for it. The thread's folder is its worktree, or else its project's folder,
# from T3 Code's state database. Both are T3 Code internals, so a change there leaves no path, and
# the key opens a new window.
t3_code_folder() {
    local thread
    applescript -l JavaScript "$T3_CODE" <<'EOF' || return 1
ObjC.import("AppKit");
ObjC.bindFunction("AXIsProcessTrusted", ["bool", []]);
ObjC.bindFunction("AXUIElementCreateApplication", ["id", ["int"]]);
ObjC.bindFunction("AXUIElementCopyAttributeValue", ["int", ["id", "id", "id*"]]);
function run(argv) {
  if (!$.AXIsProcessTrusted()) throw new Error("not allowed assistive access to read T3 Code's page (-25211)");
  const apps = $.NSRunningApplication.runningApplicationsWithBundleIdentifier(argv[0]);
  if (apps.count === 0) return "";
  const attr = (el, name) => {
    const out = Ref();
    return $.AXUIElementCopyAttributeValue(el, $(name), out) === 0 ? out[0] : null;
  };
  // The app's page is the web area at t3code:, not a browser pane's
  const find = (el, depth) => {
    const role = attr(el, "AXRole");
    if (role && ObjC.unwrap(role) === "AXWebArea") {
      const url = attr(el, "AXURL");
      const s = url ? ObjC.unwrap(url.absoluteString) : "";
      return s.startsWith("t3code:") ? s : "";
    }
    const kids = depth < 15 ? attr(el, "AXChildren") : null;
    for (let i = 0; kids && i < kids.count; i++) {
      const found = find(kids.objectAtIndex(i), depth + 1);
      if (found) return found;
    }
    return "";
  };
  const app = $.AXUIElementCreateApplication(apps.objectAtIndex(0).processIdentifier);
  const win = attr(app, "AXFocusedWindow") || attr(app, "AXMainWindow");
  return win ? find(win, 0) : "";
}
EOF
    thread="${SCRIPT_RESULT%%\?*}"
    thread="${thread##*/}"
    # A UUID, so it's safe in the query; settings and other pages have none
    if ! [[ "$thread" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
        log "T3 Code isn't showing a thread: ${SCRIPT_RESULT:-no page found}"
        return 0
    fi
    CONTEXT_PATH="$(sqlite3 -readonly "$T3_STATE" "
        SELECT coalesce(json_extract(t.payload_json, '\$.worktreePath'), p.workspace_root)
        FROM orchestration_v2_projection_threads t
        LEFT JOIN projection_projects p ON p.project_id = t.project_id
        WHERE t.thread_id = '$thread'" 2>&1)" || {
        log "ERROR couldn't read thread $thread's folder from $T3_STATE: $CONTEXT_PATH"
        CONTEXT_PATH=""
    }
}

# The first selected item, or the front window's folder, or the Desktop with no window open
finder_selection() {
    applescript <<'EOF' || return 1
tell application "Finder"
    set selected to selection
    if selected is not {} then return POSIX path of (item 1 of selected as alias)
    return POSIX path of (insertion location as alias)
end tell
EOF
    CONTEXT_PATH="$SCRIPT_RESULT"
}

# Set CONTEXT_PATH to the path the front app is showing, if it's one that exists here. A remote
# one, such as a Zed project over SSH, doesn't.
read_context_path() {
    CONTEXT_PATH=""
    case "$1" in
        "$GHOSTTY") ghostty_folder ;;
        "$ZED") zed_file ;;
        com.apple.finder) finder_selection ;;
        "$T3_CODE") t3_code_folder ;;
    esac
    # Finder ends a folder's path with a slash
    [ "$CONTEXT_PATH" == / ] || CONTEXT_PATH="${CONTEXT_PATH%/}"
    [ -n "$CONTEXT_PATH" ] && [ -e "$CONTEXT_PATH" ] || CONTEXT_PATH=""
}

# A package, such as an app, is a folder Finder shows as a file, and opening one launches it
is_package() {
    mdls -raw -name kMDItemContentTypeTree "$1" 2>/dev/null | grep -q '"com.apple.package"'
}

open_finder() {
    if [ -d "$1" ] && ! is_package "$1"; then
        open "$1"
    elif [ -n "$1" ]; then
        open -R "$1"
    else
        applescript <<'EOF'
tell application "Finder"
    make new Finder window to home
    activate
end tell
EOF
    fi
}

open_editor() {
    if [ -n "$1" ]; then
        open -b "$ZED" "$1"
    else
        "$ZED_CLI" --new
    fi
}

# Open Ghostty at a folder, or a file's folder: in a new tab when Ghostty is in front, otherwise
# in a new window
open_terminal() {
    local dir="$1" mode=window
    [ -d "$dir" ] || dir="$(dirname "$dir")"
    [ "$2" == "$GHOSTTY" ] && mode=tab
    # Telling Ghostty to start would open its first window as well as this one
    if ! app_running "$GHOSTTY"; then
        open -b "$GHOSTTY" --args "--working-directory=$dir"
        return
    fi
    applescript "$dir" "$mode" <<EOF
on run argv
    tell application id "$GHOSTTY"
        set cfg to new surface configuration
        set initial working directory of cfg to item 1 of argv
        if item 2 of argv is "tab" and (count of windows) > 0 then
            new tab in front window with configuration cfg
        else
            new window with configuration cfg
        end if
        activate
    end tell
end run
EOF
}

# open_path <files|editor|terminal>: open what's in front in Finder, Zed, or Ghostty
open_path() {
    local target="$1" front status=0
    front="$(bundle_id "$(lsappinfo front 2> /dev/null)")"
    read_context_path "$front"
    log "$target from ${front:-an unknown app}: ${CONTEXT_PATH:-no path, so a new window}"
    case "$target" in
        files) open_finder "$CONTEXT_PATH" || status=1 ;;
        editor) open_editor "$CONTEXT_PATH" || status=1 ;;
        terminal) open_terminal "${CONTEXT_PATH:-$HOME}" "$front" || status=1 ;;
    esac
    if [ "$status" -ne 0 ]; then
        log "ERROR couldn't open ${CONTEXT_PATH:-a new window} for $target"
        FAILURE="Couldn't open ${CONTEXT_PATH:-a new window}. See $CALLER_LOG"
    fi
}

# Whitespace alone isn't worth pasting. grep reads all of the clipboard, as grep -q wouldn't:
# pbpaste would then get SIGPIPE on a large clipboard, and pipefail would make that no text.
clipboard_has_text() {
    pbpaste 2> /dev/null | grep '[^[:space:]]' > /dev/null
}

# Open an app, or bring it to the front. With "activate", a running app is told to activate rather
# than opened: open sends a reopen event, which makes Chrome open a window when it has none, and
# the new tab's Cmd+T would then add a second tab.
open_app() {
    if [ "${2:-}" == activate ] && app_running "$1"; then
        applescript <<EOF
tell application id "$1" to activate
EOF
    else
        open -b "$1"
    fi
}

# Wait for Chrome to come to the front, which includes starting it, and for the keys pressed to
# run this to be released, then press Cmd+T, and with "paste", Cmd+V and Cmd+A once the new tab's
# address bar has focus. With no window open, Cmd+T opens one. SCRIPT_RESULT is "moved" when
# another app came to the front before the paste, which then isn't pressed.
# Hammerspoon's Ctrl+Opt+Cmd+N runs it while those keys are still down, which would turn Cmd+T
# into Ctrl+Opt+Cmd+T, Hammerspoon's terminal hotkey. Shift, Control, Option, and Command are bits
# 17 to 20 of NSEvent's modifierFlags. Both waits share 10 seconds, after which it fails rather
# than press anything.
new_tab() {
    applescript "$1" <<EOF
use framework "AppKit"
use scripting additions

on chromeInFront()
    tell application "System Events" to return bundle identifier of (first application process whose frontmost is true) is "$CHROME"
end chromeInFront

on modifiersHeld()
    return (((current application's NSEvent's modifierFlags()) as integer) div 131072) mod 16 is not 0
end modifiersHeld

on run argv
    repeat 200 times
        if chromeInFront() and not modifiersHeld() then exit repeat
        delay 0.05
    end repeat
    if not chromeInFront() then error "Google Chrome didn't come to the front"
    if modifiersHeld() then error "modifier keys were still held, so the new tab's Cmd+T would have taken them"
    tell application "System Events"
        keystroke "t" using command down
        if item 1 of argv is "paste" then
            delay 0.15
            if bundle identifier of (first application process whose frontmost is true) is not "$CHROME" then return "moved"
            keystroke "v" using command down
            keystroke "a" using command down
        end if
    end tell
end run
EOF
}

# Select the first tab, front window first, whose URL is Gmail's, and raise its window, or open
# Gmail in a new tab of the front window. Chrome's own AppleScript does this, so it needs no
# Accessibility. SCRIPT_RESULT is "found" or "opened".
gmail_tab() {
    applescript "$GMAIL_URL" <<EOF
on run argv
    tell application id "$CHROME"
        repeat with w in windows
            set urls to URL of tabs of w
            repeat with i from 1 to count of urls
                if item i of urls starts with "https://mail.google.com/" then
                    set active tab index of w to i
                    if minimized of w then set minimized of w to false
                    set index of w to 1
                    activate
                    return "found"
                end if
            end repeat
        end repeat
        if (count of windows) is 0 then make new window
        tell window 1 to make new tab with properties {URL:item 1 of argv}
        activate
        return "opened"
    end tell
end run
EOF
}

# open_target_app <claude|chrome|chrome-tab|gmail|t3-code|activity-monitor>
open_target_app() {
    local target="$1" bundle name paste=no how=""
    case "$target" in
        claude) bundle="$CLAUDE" name=Claude ;;
        chrome | chrome-tab | gmail) bundle="$CHROME" name="Google Chrome" ;;
        t3-code) bundle="$T3_CODE" name="T3 Code" ;;
        activity-monitor) bundle="$ACTIVITY_MONITOR" name="Activity Monitor" ;;
    esac
    [ "$target" != chrome-tab ] || how=activate
    if ! open_app "$bundle" "$how"; then
        log "ERROR couldn't open $name"
        FAILURE="Couldn't open $name. Is it installed?"
        return
    fi
    case "$target" in
        gmail)
            if ! gmail_tab; then
                FAILURE="Couldn't open Gmail. See $CALLER_LOG"
            elif [ "$SCRIPT_RESULT" == found ]; then
                log "$target: brought the Gmail tab to the front"
            else
                log "$target: opened Gmail in a new tab"
            fi
            ;;
        chrome-tab)
            ! clipboard_has_text || paste="paste"
            if ! new_tab "$paste"; then
                FAILURE="Couldn't open a new Chrome tab. See $CALLER_LOG"
            elif [ "$SCRIPT_RESULT" == moved ]; then
                log "$target: opened a new tab, but another app came to the front before the paste"
            elif [ "$paste" == paste ]; then
                log "$target: opened a new tab with the clipboard pasted"
            else
                log "$target: opened a new tab"
            fi
            ;;
        *) log "$target: opened $name" ;;
    esac
}

main() {
    local target="${1:-}"
    case "$target" in
        files | editor | terminal) open_path "$target" ;;
        claude | chrome | chrome-tab | gmail | t3-code | activity-monitor) open_target_app "$target" ;;
        *)
            echo "Usage: open-in files|editor|terminal|claude|chrome|chrome-tab|gmail|t3-code|activity-monitor" >&2
            return 2
            ;;
    esac
    if [ -n "$PERMISSION_ERROR" ]; then
        notify "$CALLER lacks a permission: $PERMISSION_ERROR"
        return 1
    elif [ -n "$FAILURE" ]; then
        notify "$FAILURE"
        return 1
    fi
}

main "$@"
