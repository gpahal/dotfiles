#!/bin/bash
set -uo pipefail

# Usage: open-in files|editor|terminal|claude|chrome|chrome-tab|gmail|t3-code|activity-monitor
# files, editor, and terminal open the front app's path in Finder, Zed, or Ghostty, else a new
# window; the others open or raise an app. Run by the Stream Deck plugin and Hammerspoon, each of
# which needs its own Automation and Accessibility permissions. Exits 1 and notifies on failure.

# Stream Deck starts plugins with a minimal environment
PATH="${PATH:+$PATH:}/usr/bin:/bin"
GHOSTTY=com.mitchellh.ghostty
ZED=dev.zed.Zed
ZED_CLI="${DOTFILES_ZED_CLI:-/Applications/Zed.app/Contents/MacOS/cli}"
T3_CODE=com.t3tools.t3code
CLAUDE=com.anthropic.claudefordesktop
CHROME=com.google.Chrome
ACTIVITY_MONITOR=com.apple.ActivityMonitor
GMAIL_URL=https://mail.google.com/mail/u/0/#inbox
T3_STATE="${DOTFILES_T3_STATE:-$HOME/.t3/userdata/statev2.sqlite}"
# The per-user temporary folder, also when Stream Deck leaves TMPDIR out of the environment
NEW_TAB_LOCK="${TMPDIR:-$(getconf DARWIN_USER_TEMP_DIR)}/dotfiles-new-tab.lock"
CALLER="${OPEN_IN_CALLER:-Stream Deck}"
CALLER_LOG="${OPEN_IN_LOG:-~/Library/Logs/ElgatoStreamDeck/com.gpahal.dotfiles0.log}"
# Set, not printed: a command substitution's subshell would lose PERMISSION_ERROR
SCRIPT_RESULT=""
PERMISSION_ERROR=""
CONTEXT_PATH=""
FAILURE=""

# The callers timestamp each line
log() {
    printf '%s\n' "$*" >&2
}

notify() {
    osascript - "$1" "$CALLER" <<'EOF' > /dev/null 2>&1
on run argv
    display notification (item 1 of argv) with title (item 2 of argv)
end run
EOF
}

# -1743 is denied Automation; -25211, 1002, or "assistive access" is missing Accessibility. Not
# -1719, which Zed with no window also gives.
applescript() {
    local err status=0 lang=()
    if [ "${1:-}" == -l ]; then
        lang=(-l "$2")
        shift 2
    fi
    SCRIPT_RESULT=""
    err="$(mktemp)" || return 1
    SCRIPT_RESULT="$(osascript ${lang[@]+"${lang[@]}"} - "$@" 2> "$err")" || status=$?
    if [ "$status" -ne 0 ]; then
        log "ERROR $(tr '\n' ' ' < "$err")"
        if grep -qE -- '-1743|-25211|\(1002\)|assistive access' "$err"; then
            PERMISSION_ERROR="$(head -n 1 "$err")"
        fi
    fi
    rm -f "$err"
    return "$status"
}

bundle_id() {
    lsappinfo info -only bundleID "$1" 2> /dev/null | sed -n 's/.*bundleID="\([^"]*\)".*/\1/p'
}

app_running() {
    [ -n "$(lsappinfo find "bundleid=$1" 2> /dev/null)" ]
}

ghostty_folder() {
    applescript <<EOF || return 1
tell application id "$GHOSTTY" to get working directory of focused terminal of selected tab of front window
EOF
    CONTEXT_PATH="$SCRIPT_RESULT"
    # Ghostty drops OSC 7 when the hostname doesn't fit in a URL; the macos step fixes that
    [ -n "$CONTEXT_PATH" ] ||
        log "Ghostty doesn't know the tab's folder. Run: bash setup.sh --status macos"
}

# Relies on zed/settings.json's window_title_format "${projectName}${separator}${filePath}"
zed_file() {
    local title
    applescript <<EOF || return 1
tell application "System Events" to get name of window 1 of (first process whose bundle identifier is "$ZED")
EOF
    title="$SCRIPT_RESULT"
    case "$title" in
        *" — /"*) CONTEXT_PATH="/${title#*" — /"}" ;;
        *" — ~/"*) CONTEXT_PATH="$HOME/${title#*" — ~/"}" ;;
    esac
}

# Reads the thread ID from the page's AXURL (JXA, since AppleScript can't) and its folder from
# T3 Code's state database. Both are T3 Code internals.
t3_code_folder() {
    local thread
    applescript -l JavaScript "$T3_CODE" <<'EOF' || return 1
ObjC.import("AppKit");
ObjC.bindFunction("AXIsProcessTrusted", ["bool", []]);
ObjC.bindFunction("AXUIElementCreateApplication", ["id", ["int"]]);
ObjC.bindFunction("AXUIElementCopyAttributeValue", ["int", ["id", "id", "id*"]]);
function run(argv) {
  if (!$.AXIsProcessTrusted()) throw new Error("not allowed assistive access to read T3 Code's page (-25211)");
  const apps = $.NSRunningApplication.runningApplicationsWithBundleIdentifier(argv[0]);
  if (apps.count === 0) return "";
  const attr = (el, name) => {
    const out = Ref();
    return $.AXUIElementCopyAttributeValue(el, $(name), out) === 0 ? out[0] : null;
  };
  // The app's page is the web area at t3code:, not a browser pane's
  const find = (el, depth) => {
    const role = attr(el, "AXRole");
    if (role && ObjC.unwrap(role) === "AXWebArea") {
      const url = attr(el, "AXURL");
      const s = url ? ObjC.unwrap(url.absoluteString) : "";
      return s.startsWith("t3code:") ? s : "";
    }
    const kids = depth < 15 ? attr(el, "AXChildren") : null;
    for (let i = 0; kids && i < kids.count; i++) {
      const found = find(kids.objectAtIndex(i), depth + 1);
      if (found) return found;
    }
    return "";
  };
  const app = $.AXUIElementCreateApplication(apps.objectAtIndex(0).processIdentifier);
  const win = attr(app, "AXFocusedWindow") || attr(app, "AXMainWindow");
  return win ? find(win, 0) : "";
}
EOF
    thread="${SCRIPT_RESULT%%\?*}"
    thread="${thread##*/}"
    # Validated as a UUID, so it's safe in the query
    if ! [[ "$thread" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
        log "T3 Code isn't showing a thread: ${SCRIPT_RESULT:-no page found}"
        return 0
    fi
    CONTEXT_PATH="$(sqlite3 -readonly "$T3_STATE" "
        SELECT coalesce(json_extract(t.payload_json, '\$.worktreePath'), p.workspace_root)
        FROM orchestration_v2_projection_threads t
        LEFT JOIN projection_projects p ON p.project_id = t.project_id
        WHERE t.thread_id = '$thread'" 2>&1)" || {
        log "ERROR couldn't read thread $thread's folder from $T3_STATE: $CONTEXT_PATH"
        CONTEXT_PATH=""
    }
}

finder_selection() {
    applescript <<'EOF' || return 1
tell application "Finder"
    set selected to selection
    if selected is not {} then return POSIX path of (item 1 of selected as alias)
    return POSIX path of (insertion location as alias)
end tell
EOF
    CONTEXT_PATH="$SCRIPT_RESULT"
}

# Remote paths, such as a Zed project over SSH, don't exist here
read_context_path() {
    CONTEXT_PATH=""
    case "$1" in
        "$GHOSTTY") ghostty_folder ;;
        "$ZED") zed_file ;;
        com.apple.finder) finder_selection ;;
        "$T3_CODE") t3_code_folder ;;
    esac
    [ "$CONTEXT_PATH" == / ] || CONTEXT_PATH="${CONTEXT_PATH%/}"
    [ -n "$CONTEXT_PATH" ] && [ -e "$CONTEXT_PATH" ] || CONTEXT_PATH=""
}

# Opening a package (e.g. an app) would launch it
is_package() {
    mdls -raw -name kMDItemContentTypeTree "$1" 2>/dev/null | grep -q '"com.apple.package"'
}

open_finder() {
    if [ -d "$1" ] && ! is_package "$1"; then
        open "$1"
    elif [ -n "$1" ]; then
        open -R "$1"
    else
        applescript <<'EOF'
tell application "Finder"
    make new Finder window to home
    activate
end tell
EOF
    fi
}

open_editor() {
    if [ -n "$1" ]; then
        open -b "$ZED" "$1"
    else
        "$ZED_CLI" --new
    fi
}

open_terminal() {
    local dir="$1" mode=window
    [ -d "$dir" ] || dir="$(dirname "$dir")"
    [ "$2" == "$GHOSTTY" ] && mode=tab
    # Telling Ghostty to start would also open its default window
    if ! app_running "$GHOSTTY"; then
        open -b "$GHOSTTY" --args "--working-directory=$dir"
        return
    fi
    applescript "$dir" "$mode" <<EOF
on run argv
    tell application id "$GHOSTTY"
        set cfg to new surface configuration
        set initial working directory of cfg to item 1 of argv
        if item 2 of argv is "tab" and (count of windows) > 0 then
            new tab in front window with configuration cfg
        else
            new window with configuration cfg
        end if
        activate
    end tell
end run
EOF
}

open_path() {
    local target="$1" front status=0
    front="$(bundle_id "$(lsappinfo front 2> /dev/null)")"
    read_context_path "$front"
    log "$target from ${front:-an unknown app}: ${CONTEXT_PATH:-no path, so a new window}"
    case "$target" in
        files) open_finder "$CONTEXT_PATH" || status=1 ;;
        editor) open_editor "$CONTEXT_PATH" || status=1 ;;
        terminal) open_terminal "${CONTEXT_PATH:-$HOME}" "$front" || status=1 ;;
    esac
    if [ "$status" -ne 0 ]; then
        log "ERROR couldn't open ${CONTEXT_PATH:-a new window} for $target"
        FAILURE="Couldn't open ${CONTEXT_PATH:-a new window}. See $CALLER_LOG"
    fi
}

# Not grep -q: pbpaste would get SIGPIPE on a large clipboard and fail under pipefail
clipboard_has_text() {
    pbpaste 2> /dev/null | grep '[^[:space:]]' > /dev/null
}

# "activate" avoids open's reopen event, which makes a windowless Chrome open a window that
# Cmd+T would then add a second tab to
open_app() {
    if [ "${2:-}" == activate ] && app_running "$1"; then
        applescript <<EOF
tell application id "$1" to activate
EOF
    else
        open -b "$1"
    fi
}

# One New Tab at a time, from the Stream Deck and Hammerspoon alike: two at once would each open a
# tab, then both paste into whichever is in front. mkdir is atomic. A lock whose process is gone,
# or that got no process ID within a minute, is taken over.
take_new_tab_lock() {
    local pid=""
    if ! mkdir "$NEW_TAB_LOCK" 2> /dev/null; then
        read -r pid < "$NEW_TAB_LOCK/pid" 2> /dev/null
        if [ -n "$pid" ]; then
            ! kill -0 "$pid" 2> /dev/null || return 1
        elif [ -z "$(find "$NEW_TAB_LOCK" -maxdepth 0 -mmin +1 2> /dev/null)" ]; then
            return 1
        fi
        rm -rf "$NEW_TAB_LOCK"
        mkdir "$NEW_TAB_LOCK" 2> /dev/null || return 1
    fi
    echo "$$" > "$NEW_TAB_LOCK/pid"
    trap 'rm -rf "$NEW_TAB_LOCK"' EXIT
}

# Waits up to 10 s for modifiers to be released: Hammerspoon's Ctrl+Opt+Cmd+N would otherwise turn
# Cmd+T into its terminal hotkey. Bits 17-20 of modifierFlags are the modifiers. SCRIPT_RESULT
# "moved" means another app came to the front before the paste.
new_tab() {
    applescript "$1" <<EOF
use framework "AppKit"
use scripting additions

on chromeInFront()
    tell application "System Events" to return bundle identifier of (first application process whose frontmost is true) is "$CHROME"
end chromeInFront

on modifiersHeld()
    return (((current application's NSEvent's modifierFlags()) as integer) div 131072) mod 16 is not 0
end modifiersHeld

on run argv
    set deadline to (current date) + 10
    repeat while (current date) < deadline
        if chromeInFront() and not modifiersHeld() then exit repeat
        delay 0.05
    end repeat
    if not chromeInFront() then error "Google Chrome didn't come to the front"
    if modifiersHeld() then error "modifier keys were still held, so the new tab's Cmd+T would have taken them"
    tell application "System Events"
        keystroke "t" using command down
        if item 1 of argv is "paste" then
            delay 0.15
            if bundle identifier of (first application process whose frontmost is true) is not "$CHROME" then return "moved"
            keystroke "v" using command down
            keystroke "a" using command down
        end if
    end tell
end run
EOF
}

# Chrome's own AppleScript, so no Accessibility needed. SCRIPT_RESULT is "found" or "opened".
gmail_tab() {
    applescript "$GMAIL_URL" <<EOF
on run argv
    tell application id "$CHROME"
        repeat with w in windows
            set urls to URL of tabs of w
            repeat with i from 1 to count of urls
                if item i of urls starts with "https://mail.google.com/" then
                    set active tab index of w to i
                    if minimized of w then set minimized of w to false
                    set index of w to 1
                    activate
                    return "found"
                end if
            end repeat
        end repeat
        if (count of windows) is 0 then make new window
        tell window 1 to make new tab with properties {URL:item 1 of argv}
        activate
        return "opened"
    end tell
end run
EOF
}

open_target_app() {
    local target="$1" bundle name paste=no how=""
    case "$target" in
        claude) bundle="$CLAUDE" name=Claude ;;
        chrome | chrome-tab | gmail) bundle="$CHROME" name="Google Chrome" ;;
        t3-code) bundle="$T3_CODE" name="T3 Code" ;;
        activity-monitor) bundle="$ACTIVITY_MONITOR" name="Activity Monitor" ;;
    esac
    if [ "$target" == chrome-tab ]; then
        how=activate
        if ! take_new_tab_lock; then
            log "$target: another New Tab is still running, so this one did nothing"
            return
        fi
    fi
    if ! open_app "$bundle" "$how"; then
        log "ERROR couldn't open $name"
        FAILURE="Couldn't open $name. Is it installed?"
        return
    fi
    case "$target" in
        gmail)
            if ! gmail_tab; then
                FAILURE="Couldn't open Gmail. See $CALLER_LOG"
            elif [ "$SCRIPT_RESULT" == found ]; then
                log "$target: brought the Gmail tab to the front"
            else
                log "$target: opened Gmail in a new tab"
            fi
            ;;
        chrome-tab)
            ! clipboard_has_text || paste="paste"
            if ! new_tab "$paste"; then
                FAILURE="Couldn't open a new Chrome tab. See $CALLER_LOG"
            elif [ "$SCRIPT_RESULT" == moved ]; then
                log "$target: opened a new tab, but another app came to the front before the paste"
            elif [ "$paste" == paste ]; then
                log "$target: opened a new tab with the clipboard pasted"
            else
                log "$target: opened a new tab"
            fi
            ;;
        *) log "$target: opened $name" ;;
    esac
}

main() {
    local target="${1:-}"
    case "$target" in
        files | editor | terminal) open_path "$target" ;;
        claude | chrome | chrome-tab | gmail | t3-code | activity-monitor) open_target_app "$target" ;;
        *)
            echo "Usage: open-in files|editor|terminal|claude|chrome|chrome-tab|gmail|t3-code|activity-monitor" >&2
            return 2
            ;;
    esac
    if [ -n "$PERMISSION_ERROR" ]; then
        notify "$CALLER lacks a permission: $PERMISSION_ERROR"
        return 1
    elif [ -n "$FAILURE" ]; then
        notify "$FAILURE"
        return 1
    fi
}

main "$@"
