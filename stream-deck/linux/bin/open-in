#!/bin/bash
set -uo pipefail

# Usage: open-in editor|terminal|files|agenda|chrome|chrome-tab|gmail|t3-code|claude|activity-monitor
# The Ubuntu sibling of the Mac plugin's bin/open-in, run by the Stream Deck daemon and the hotkeys
# step's shortcuts. editor, terminal, and files open the front app's path in Zed, Ghostty, or
# Nautilus, else a new window; the others focus or launch an app. Wayland lets only the shell read and
# focus windows, so this asks the dotfiles GNOME extension (gnome-extension/). Exits 1 and notifies
# on failure.

# A user service gets systemd's PATH, without Homebrew's or snap's
PATH="${PATH:+$PATH:}/home/linuxbrew/.linuxbrew/bin:/snap/bin:/usr/bin:/bin"
# The stream-deck step installs the Mac plugin's open-in-lib.sh beside this
# shellcheck source=../../com.gpahal.dotfiles.sdPlugin/bin/open-in-lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/open-in-lib.sh" || exit 127
# Window classes
GHOSTTY=com.mitchellh.ghostty
ZED=dev.zed.Zed
NAUTILUS=org.gnome.Nautilus
CHROME=google-chrome
# ActivateApp takes the desktop file that launches the app, and the class its windows have
CHROME_APP=google-chrome.desktop
GMAIL_APP=dotfiles-gmail.desktop
GMAIL_CLASS=chrome-mail.google.com__mail_u_0_-Default
AGENDA_APP=dotfiles-agenda.desktop
AGENDA_CLASS=chrome-garvitpahal.com__x_agenda-Default
CLAUDE_APP=com.anthropic.Claude.desktop
CLAUDE_CLASS=com.anthropic.Claude
# T3 Code's windows belong to a desktop file it writes at run time, com.t3tools.T3Code.desktop
T3_CODE_APP=t3code.desktop
T3_CODE_CLASS=com.t3tools.T3Code
RESOURCES_APP=net.nokyan.Resources.desktop
RESOURCES_CLASS=net.nokyan.Resources
# How long a window this opens may take to appear and still come to the front
EXPECT_MS=10000
# Seconds New Tab waits for Chrome in front with no modifiers held; the tests shorten it
NEW_TAB_WAIT="${DOTFILES_NEW_TAB_WAIT:-10}"
NEW_TAB_LOCK="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/dotfiles-new-tab-$UID.lock"
CALLER="${OPEN_IN_CALLER:-Stream Deck}"
CALLER_LOG="${OPEN_IN_LOG:-journalctl --user -u dotfiles-stream-deck}"
FRONT_KIND=window
# Set, not printed: a command substitution's subshell would lose FAILURE
SHELL_REPLY=""
CONTEXT_PATH=""
FAILURE=""

notify() {
    notify-send --app-name="$CALLER" "$CALLER" "$1" > /dev/null 2>&1
}

# Sets SHELL_REPLY to the reply's value: a string, true or false, or nothing. busctl's JSON keeps
# a title's quotes intact, which gdbus's GVariant text doesn't.
shell_call() {
    local method="$1" out err status=0
    shift
    SHELL_REPLY=""
    err="$(mktemp)" || return 1
    out="$(busctl --user --json=short call org.gnome.Shell /com/gpahal/Dotfiles com.gpahal.Dotfiles \
        "$method" "$@" 2> "$err")" || status=$?
    if [ "$status" -ne 0 ]; then
        log "ERROR the dotfiles GNOME extension didn't answer $method: $(tr '\n' ' ' < "$err")"
        FAILURE="The dotfiles GNOME extension isn't running. Log out and back in, or see: bash setup.sh --status stream-deck"
    fi
    rm -f "$err"
    [ "$status" -eq 0 ] || return 1
    # Not jq's //, which drops false
    SHELL_REPLY="$(jq -r '.data | if length == 0 then "" else .[0] | tostring end' <<< "$out")"
}

# Outside this process's service, so restarting the daemon doesn't close what it opened.
# ExitType=cgroup keeps the unit, and the app, after a CLI such as zed hands off and exits.
launch() {
    local cmd
    if ! cmd="$(command -v "$1")"; then
        log "ERROR $1 isn't installed"
        return 1
    fi
    shift
    systemd-run --user --quiet --collect -p ExitType=cgroup -- "$cmd" "$@"
}

# Mutter won't focus a window another process opens, so the extension focuses the next one
expect_window() {
    shell_call ExpectWindow su "$1" "$EXPECT_MS"
}

# zsh/title.zsh sets the title to the folder, or on Linux to "<command> — <folder>" while one runs
ghostty_folder() {
    local title="$1" dir
    dir="${title##*" — "}"
    # shellcheck disable=SC2088 # a literal ~ from the title
    case "$dir" in
        "~") dir="$HOME" ;;
        "~/"*) dir="$HOME/${dir#"~/"}" ;;
        /*) ;;
        *) dir="" ;;
    esac
    CONTEXT_PATH="$dir"
    [ -n "$dir" ] || log "Ghostty's title doesn't end with its folder: $title"
}

uri_path() {
    local path="${1#file://}"
    printf '%b' "${path//%/\\x}"
}

# Nautilus lists each window's tabs but not which is active or selected, so this takes the tab
# whose folder name is the window's title, else the first
nautilus_folder() {
    local window="$1" title="$2" uris uri path first=""
    [ -n "$window" ] || return 0
    uris="$(busctl --user --json=short get-property org.freedesktop.FileManager1 /org/freedesktop/FileManager1 \
        org.freedesktop.FileManager1 OpenWindowsWithLocations 2> /dev/null |
        jq -r --arg w "$window" '.data[$w][]? // empty')" || return 0
    while IFS= read -r uri; do
        case "$uri" in file://*) ;; *) continue ;; esac
        path="$(uri_path "$uri")"
        [ -n "$first" ] || first="$path"
        if [ "${path##*/}" == "$title" ]; then
            CONTEXT_PATH="$path"
            return 0
        fi
    done <<< "$uris"
    CONTEXT_PATH="$first"
}

# Sets FRONT_CLASS, FRONT_TITLE, and FRONT_WINDOW (the GTK window's object path)
read_front() {
    shell_call FocusedWindow || return 1
    FRONT_CLASS="$(jq -r '.wmClass // ""' <<< "$SHELL_REPLY")"
    FRONT_TITLE="$(jq -r '.title // ""' <<< "$SHELL_REPLY")"
    FRONT_WINDOW="$(jq -r '.gtkObjectPath // ""' <<< "$SHELL_REPLY")"
}

read_context_path() {
    CONTEXT_PATH=""
    case "$FRONT_CLASS" in
        "$GHOSTTY") ghostty_folder "$FRONT_TITLE" ;;
        "$ZED") zed_title_path "$FRONT_TITLE" ;;
        "$NAUTILUS") nautilus_folder "$FRONT_WINDOW" "$FRONT_TITLE" ;;
    esac
    check_context_path
}

file_uri() {
    jq -rn --arg p "$1" '"file://" + ($p | split("/") | map(@uri) | join("/"))'
}

open_files() {
    expect_window "$NAUTILUS" || return 1
    if [ -d "$1" ]; then
        launch nautilus --new-window "$1"
    elif [ -n "$1" ]; then
        busctl --user call org.freedesktop.FileManager1 /org/freedesktop/FileManager1 \
            org.freedesktop.FileManager1 ShowItems ass 1 "$(file_uri "$1")" ""
    else
        launch nautilus --new-window "$HOME"
    fi
}

open_editor() {
    expect_window "$ZED" || return 1
    if [ -n "$1" ]; then
        launch zed "$1"
    else
        launch zed --new
    fi
}

# Ghostty 1.3 on Linux opens windows, not tabs, from outside
open_terminal() {
    local dir="$1"
    [ -d "$dir" ] || dir="$(dirname "$dir")"
    expect_window "$GHOSTTY" || return 1
    if pgrep -x ghostty > /dev/null; then
        launch ghostty +new-window "--working-directory=$dir"
    else
        launch ghostty "--working-directory=$dir"
    fi
}

open_path() {
    local target="$1" status=0
    read_front || return
    read_context_path
    log "$target from ${FRONT_CLASS:-an unknown window}: ${CONTEXT_PATH:-no path, so a new window}"
    case "$target" in
        files) open_files "$CONTEXT_PATH" || status=1 ;;
        editor) open_editor "$CONTEXT_PATH" || status=1 ;;
        terminal) open_terminal "${CONTEXT_PATH:-$HOME}" || status=1 ;;
    esac
    open_path_result "$target" "$status"
}

chrome_in_front() {
    shell_call FocusedWindow || return 1
    [ "$(jq -r '.wmClass // ""' <<< "$SHELL_REPLY")" == "$CHROME" ]
}

modifiers_held() {
    shell_call ModifiersHeld && [ "$SHELL_REPLY" == true ]
}

send_keys() {
    shell_call SendKeys s "$1" && [ "$SHELL_REPLY" == true ]
}

# Waits for Chrome to come to the front and for modifiers to be released: a hotkey's held
# modifiers would turn Ctrl+T into another shortcut. Sets NEW_TAB "moved" when another window came
# to the front before the paste.
new_tab() {
    local deadline=$((SECONDS + NEW_TAB_WAIT))
    NEW_TAB=""
    until chrome_in_front && ! modifiers_held; do
        [ -z "$FAILURE" ] || return 1
        [ "$SECONDS" -lt "$deadline" ] || break
        sleep 0.05
    done
    if ! chrome_in_front; then
        log "ERROR Google Chrome didn't come to the front"
        return 1
    fi
    if modifiers_held; then
        log "ERROR modifier keys were still held, so the new tab's Ctrl+T would have taken them"
        return 1
    fi
    send_keys ctrl+t || return 1
    [ "$1" == paste ] || return 0
    sleep 0.15
    if ! chrome_in_front; then
        NEW_TAB=moved
        return 0
    fi
    send_keys ctrl+v && send_keys ctrl+a
}

open_target_app() {
    local target="$1" app class name paste=""
    case "$target" in
        claude) app="$CLAUDE_APP" class="$CLAUDE_CLASS" name=Claude ;;
        chrome | chrome-tab) app="$CHROME_APP" class="$CHROME" name="Google Chrome" ;;
        gmail) app="$GMAIL_APP" class="$GMAIL_CLASS" name=Gmail ;;
        agenda) app="$AGENDA_APP" class="$AGENDA_CLASS" name=Agenda ;;
        t3-code) app="$T3_CODE_APP" class="$T3_CODE_CLASS" name="T3 Code" ;;
        activity-monitor) app="$RESOURCES_APP" class="$RESOURCES_CLASS" name=Resources ;;
    esac
    if [ "$target" == chrome-tab ] && ! take_new_tab_lock; then
        log "$target: another New Tab is still running, so this one did nothing"
        return
    fi
    shell_call ActivateApp ss "$app" "$class" || return
    if [ "$SHELL_REPLY" != true ]; then
        log "ERROR no app has the desktop file $app"
        FAILURE="Couldn't open $name. Is it installed?"
        return
    fi
    if [ "$target" != chrome-tab ]; then
        log "$target: opened $name"
        return
    fi
    if shell_call ClipboardHasText && [ "$SHELL_REPLY" == true ]; then
        paste="paste"
    fi
    new_tab "$paste"
    new_tab_result "$target" $? "$NEW_TAB" "$paste"
}

main() {
    local target="${1:-}"
    case "$target" in
        editor | terminal | files | agenda | chrome | chrome-tab | gmail | t3-code | claude | activity-monitor) ;;
        *)
            usage
            return 2
            ;;
    esac
    # A key pressed at the lock screen would open apps behind it
    if shell_call IsLocked && [ "$SHELL_REPLY" == true ]; then
        log "$target: the screen is locked, so nothing opened"
        return 1
    fi
    if [ -z "$FAILURE" ]; then
        case "$target" in
            files | editor | terminal) open_path "$target" ;;
            *) open_target_app "$target" ;;
        esac
    fi
    if [ -n "$FAILURE" ]; then
        notify "$FAILURE"
        return 1
    fi
}

main "$@"
