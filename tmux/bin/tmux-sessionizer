#!/bin/bash
set -euo pipefail

# Open a tmux session for a project directory, picking one from ~/Dev/*/* with fzf by default.

# Hidden-dir check only below ~/Dev, since $HOME may contain a leading dot
list_projects() {
    local dir
    if command -v fd &>/dev/null; then
        fd . "$HOME/Dev" --min-depth 2 --max-depth 2 --type d --no-ignore
    else
        find "$HOME/Dev" -mindepth 2 -maxdepth 2 -type d | while IFS= read -r dir; do
            case "/${dir#"$HOME/Dev/"}" in
                */.*) ;;
                *) printf '%s\n' "$dir" ;;
            esac
        done
    fi
}

if [ $# -gt 0 ]; then
    dir="$1"
else
    # fzf: 1 is no match, 130 cancelled. Other failures keep prefix+f's popup open to show the
    # error. `|| true`: an unreadable dir mustn't drop the pick under pipefail.
    dir="$({ list_projects || true; } | fzf)" || {
        status=$?
        [ "$status" -eq 1 ] || [ "$status" -eq 130 ] || exit "$status"
        exit 0
    }
fi
[ -n "$dir" ] || exit 0
if [ ! -d "$dir" ]; then
    echo "tmux-sessionizer: not a directory: $dir" >&2
    exit 1
fi
dir="$(CDPATH='' cd -- "$dir" && pwd)"

# Match by path, not name, so js/api keeps api_2 after go/api's api is gone. -u: without UTF-8
# tmux prints the tab as _.
name=""
while IFS=$'\t' read -r session_path session_name; do
    if [ "$session_path" == "$dir" ]; then
        name="$session_name"
        break
    fi
done < <(tmux -u list-sessions -F '#{session_path}'$'\t''#{session_name}' 2>/dev/null || true)

# tmux reads . and : in targets as separators and expands # formats in names. = matches exactly.
if [ -z "$name" ]; then
    base="$(basename "$dir" | tr '.:#' '___')"
    name="$base"
    n=1
    while tmux has-session -t "=$name" 2>/dev/null; do
        n=$((n + 1))
        name="${base}_$n"
    done
fi

# tmux expands formats in -c too
start_dir="${dir//\#/##}"
if [ -z "${TMUX:-}" ]; then
    exec tmux new-session -A -s "$name" -c "$start_dir"
fi
tmux has-session -t "=$name" 2>/dev/null || tmux new-session -d -s "$name" -c "$start_dir"
tmux switch-client -t "=$name"
