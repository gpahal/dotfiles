#!/bin/bash
set -euo pipefail

# Open a tmux session for a project directory, creating it if needed. With no argument, pick a
# project from ~/Dev/<group>/<project> with fzf. Based on ThePrimeagen's tmux-sessionizer:
# https://github.com/ThePrimeagen/dev/tree/HEAD/tmux-sessionizer

# Both include ignored projects and exclude hidden groups and projects. Check only below ~/Dev,
# since $HOME may contain a leading dot.
list_projects() {
    local dir
    if command -v fd &>/dev/null; then
        fd . "$HOME/Dev" --min-depth 2 --max-depth 2 --type d --no-ignore
    else
        find "$HOME/Dev" -mindepth 2 -maxdepth 2 -type d | while IFS= read -r dir; do
            case "/${dir#"$HOME/Dev/"}" in
                */.*) ;;
                *) printf '%s\n' "$dir" ;;
            esac
        done
    fi
}

if [ $# -gt 0 ]; then
    dir="$1"
else
    # fzf exits 1 with no match and 130 when cancelled. Anything else, such as a missing fzf
    # (127), fails, so prefix+f's popup stays open to show the error.
    # A directory find or fd can't read makes it fail after listing the rest, which mustn't drop
    # the pick under pipefail
    dir="$({ list_projects || true; } | fzf)" || {
        status=$?
        [ "$status" -eq 1 ] || [ "$status" -eq 130 ] || exit "$status"
        exit 0
    }
fi
[ -n "$dir" ] || exit 0
if [ ! -d "$dir" ]; then
    echo "tmux-sessionizer: not a directory: $dir" >&2
    exit 1
fi
# Without CDPATH, cd goes to the directory given, not one CDPATH names, and prints nothing
dir="$(CDPATH='' cd -- "$dir" && pwd)"

# The session already open for the directory, whatever its name. Matching by path, not name,
# keeps js/api on its api_2 after go/api's api is gone. list-sessions fails when no server runs.
# -u keeps the tab, which tmux prints as _ under a locale that isn't UTF-8, such as LC_ALL=C.
name=""
while IFS=$'\t' read -r session_path session_name; do
    if [ "$session_path" == "$dir" ]; then
        name="$session_name"
        break
    fi
done < <(tmux -u list-sessions -F '#{session_path}'$'\t''#{session_name}' 2>/dev/null || true)

# Otherwise a free name. tmux treats . and : in target names as window and pane separators, and
# expands formats, which start with #, in a new session's name.
# Projects with the same basename, such as ~/Dev/go/api and ~/Dev/js/api, get api, api_2, and so
# on. A leading = makes tmux match the session name exactly, not by prefix. has-session fails when
# no server runs, which ends the loop.
if [ -z "$name" ]; then
    base="$(basename "$dir" | tr '.:#' '___')"
    name="$base"
    n=1
    while tmux has-session -t "=$name" 2>/dev/null; do
        n=$((n + 1))
        name="${base}_$n"
    done
fi

# tmux expands formats in -c too, and ## there to a literal #
start_dir="${dir//\#/##}"
if [ -z "${TMUX:-}" ]; then
    exec tmux new-session -A -s "$name" -c "$start_dir"
fi
tmux has-session -t "=$name" 2>/dev/null || tmux new-session -d -s "$name" -c "$start_dir"
tmux switch-client -t "=$name"
