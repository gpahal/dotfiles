let s:plug = expand('~/.vim/autoload/plug.vim')
if filereadable(s:plug)
    augroup dotfiles_plug_install
        autocmd!
        autocmd VimEnter * if len(filter(values(g:plugs), '!isdirectory(v:val.dir)'))
            \| PlugInstall --sync | source $MYVIMRC
        \| endif
    augroup END

    " just bump-plugins moves the pins
    call plug#begin('~/.vim/plugged')
    Plug 'tpope/vim-sensible', { 'commit': '0ce2d843d6f588bb0c8c7eec6449171615dc56d9' }

    Plug 'preservim/nerdtree', { 'on': 'NERDTreeToggle', 'commit': '690d061b591525890f1471c6675bcb5bdc8cdff9' }
    Plug 'Xuyuanp/nerdtree-git-plugin', { 'on': 'NERDTreeToggle', 'commit': 'e1fe727127a813095854a5b063c15e955a77eafb' }

    " $HOMEBREW_PREFIX is unset when vim doesn't start from a shell that loaded brew
    for s:prefix in [$HOMEBREW_PREFIX, '/opt/homebrew', '/home/linuxbrew/.linuxbrew']
        if s:prefix != '' && isdirectory(s:prefix . '/opt/fzf')
            let &runtimepath .= ',' . s:prefix . '/opt/fzf'
            break
        endif
    endfor
    Plug 'junegunn/fzf.vim', { 'commit': '023de3c0e158ff9c2b0992175af10be97c2f2158' }

    Plug 'airblade/vim-gitgutter', { 'commit': '90b75207bd9b55d8ac4af15f72b4e935462014d0' }
    Plug 'tpope/vim-fugitive', { 'commit': '3b753cf8c6a4dcde6edee8827d464ba9b8c4a6f0' }

    Plug 'christoomey/vim-tmux-navigator', { 'commit': 'e41c431a0c7b7388ae7ba341f01a0d217eb3a432' }

    Plug 'tpope/vim-commentary', { 'commit': '64a654ef4a20db1727938338310209b6a63f60c9' }
    Plug 'tpope/vim-surround', { 'commit': '3d188ed2113431cf8dac77be61b842acb64433d9' }
    Plug 'tpope/vim-repeat', { 'commit': '65846025c15494983dafe5e3b46c8f88ab2e9635' }
    Plug 'jiangmiao/auto-pairs', { 'commit': '39f06b873a8449af8ff6a3eee716d3da14d63a76' }
    Plug 'andymass/vim-matchup', { 'commit': '0106b1afd4a2f7e1098037b5ceb161bab7471088' }

    Plug 'vim-airline/vim-airline', { 'commit': '8dc1bd0a116de527f6bc58c1d04386ba357c624f' }
    Plug 'vim-airline/vim-airline-themes', { 'commit': '77aab8c6cf7179ddb8a05741da7e358a86b2c3ab' }

    " Run :GoInstallBinaries by hand; it takes minutes
    Plug 'fatih/vim-go', { 'commit': '47694979496d4bf2e90ce75d95f1dec3f41cbefb' }
    Plug 'rust-lang/rust.vim', { 'commit': '889b9a7515db477f4cb6808bef1769e53493c578' }
    call plug#end()
endif

silent! packadd! editorconfig

let mapleader = " "

set encoding=utf-8
set hidden
set updatetime=250
set timeoutlen=500
set mouse=a
" Vim keeps ttymouse=xterm under tmux, which reports no drags or clicks past column 223
if has('mouse_sgr') && &term =~# '^\%(tmux\|screen\)'
    set ttymouse=sgr
endif
set clipboard=unnamed
" Ubuntu over SSH has no system clipboard, so yank through OSC 52. tmux answers the detection
" query, so force it. Paste with Cmd+V: Ghostty asks before programs read the clipboard.
if has('unix') && !has('mac') && exists('+clipmethod')
    set clipboard=unnamedplus
    let g:osc52_force_avail = 1
    let g:osc52_disable_paste = 1
    silent! packadd osc52
    set clipmethod+=osc52
endif

set number
set relativenumber
set signcolumn=yes
set scrolloff=8
set sidescrolloff=8
set colorcolumn=120
set termguicolors
set showcmd
set cursorline
set showmatch
set laststatus=2
set wildmenu
set wildmode=longest:full,full

set hlsearch
set ignorecase
set smartcase

set expandtab
set shiftwidth=4
set tabstop=4
set softtabstop=4
set smartindent
set autoindent
filetype plugin indent on
" For when vim-plug (and vim-sensible) is missing
syntax on

set lazyredraw

set noswapfile
set nobackup
set undofile
set undodir=~/.vim/undodir
" Vim doesn't create undodir. 0o700: undo files hold what you typed.
silent! call mkdir(expand('~/.vim/undodir'), 'p', 0o700)
" Modelines have a history of CVEs; EditorConfig covers per-file settings
set nomodeline

set splitbelow
set splitright

set noerrorbells visualbell t_vb=

let g:airline_theme='papercolor'

nnoremap <leader>w :w<CR>
nnoremap <leader>q :q<CR>

" Not <Esc><Esc>: a map starting with <Esc> makes vim wait timeoutlen after every Esc
nnoremap <silent> <leader><space> :nohlsearch<CR>

vnoremap J :m '>+1<CR>gv=gv
vnoremap K :m '<-2<CR>gv=gv

nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz

nnoremap n nzzzv
nnoremap N Nzzzv

vnoremap < <gv
vnoremap > >gv

nnoremap <leader>e :NERDTreeToggle<CR>

nnoremap <leader>f :Files<CR>
" Not <leader>g: it prefixes the fugitive maps below, so vim would wait timeoutlen to run it
nnoremap <leader>/ :Rg<CR>
nnoremap <leader>b :Buffers<CR>
nnoremap <C-f> :FZF<CR>

nnoremap <leader>gs :Git<CR>
nnoremap <leader>gd :Gdiffsplit<CR>
nnoremap <leader>gb :Git blame<CR>
