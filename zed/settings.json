{
  // Homebrew updates Zed (through `upgrade`), so Zed's own updater stays off
  "auto_update": false,
  "cli_default_open_behavior": "new_window",
  // The Stream Deck plugin (stream-deck/) and Hammerspoon's Ctrl+Opt+T and E read the open
  // file's path from the window title
  "window_title_format": "${projectName}${separator}${filePath}",
  "disable_ai": true,
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": false,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
}
